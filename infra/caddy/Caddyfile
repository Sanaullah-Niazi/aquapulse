# ---------------------------------------------------------------
# Caddy config (M1). Caddy is our "front door".
# M1: serve a static status page + a health endpoint on port 80
#     (published as http://localhost:8080 on your Mac).
# M3: forward /api/... to the FastAPI backend.  M5: HTTPS + security headers.
# ---------------------------------------------------------------
:80 {
	# Used by the Docker health check and the smoke test.
	handle /healthz {
		respond "ok" 200
	}

	# The API (M3). /metrics is deliberately NOT forwarded: it stays private.
	handle /api/* {
		request_body {
			max_size 1MB # no API request needs more; stops huge uploads
		}
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		file_server
	}

	# Basic safety headers now; the full set (HSTS, CSP) arrives with HTTPS in M5.
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}
