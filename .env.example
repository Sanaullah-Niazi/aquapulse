# ---------------------------------------------------------------
# AquaPulse settings. Run `make env` to create or update `.env`.
# `.env` is git-ignored, so your real secrets never reach GitHub.
# A value of __GENERATE__ becomes a random secret in your .env.
# This file grows milestone by milestone; every setting is explained.
# ---------------------------------------------------------------

# Name used for Docker containers, networks and volumes (M1).
COMPOSE_PROJECT_NAME=aquapulse

# Time zone of the demo building (M1, M6). Uses IANA names.
DEMO_TIMEZONE=Asia/Karachi

# --- Database (M1) ---
POSTGRES_DB=aquapulse
POSTGRES_USER=aquapulse
POSTGRES_PASSWORD=__GENERATE__

# --- Simulator / digital twin (M2) ---
# How many virtual homes (1 to 500). Each one is its own MQTT device.
SIM_HOMES=10
# Seconds between telemetry messages from every device (1 to 300).
SIM_INTERVAL_S=10
# Same seed = exactly the same water use every time (reproducible demos).
SIM_SEED=42
# Building code used in device IDs: home-b01-01 ... tank-b01-01.
SIM_BUILDING=b01
# Weekend days (more water is used). Gulf countries: fri,sat
SIM_WEEKEND_DAYS=sat,sun
# Overhead tank size in litres, its level when first started, and pump speed.
SIM_TANK_CAPACITY_L=5000
SIM_TANK_START_PCT=30
SIM_PUMP_LPM=60

# --- API / backend (M3) ---
# Password of the API's own database role (aquapulse_app). That role may not
# change or delete audit log entries (FR-28).
APP_DB_PASSWORD=__GENERATE__
# Secret that the key signing login tokens is made from. Changing it logs
# everyone out, unless you move the old value to JWT_PREVIOUS_SECRETS first.
JWT_SECRET=__GENERATE__
# Old JWT secrets (comma separated) that are still accepted until their tokens expire.
JWT_PREVIOUS_SECRETS=
# Password of every demo account that `make seed` creates.
DEMO_PASSWORD=__GENERATE__
# Address used in links inside emails (invitations, password resets).
PUBLIC_URL=https://localhost:8443

# --- Secure MQTT and HTTPS (M5) ---
# Passwords of the three server accounts on the MQTT broker. Each one may only
# do its own job (infra/mosquitto/acl): the ingestor reads device messages,
# the commander sends commands, the monitor only watches (health checks, tests).
MQTT_INGESTOR_PASSWORD=__GENERATE__
MQTT_COMMANDER_PASSWORD=__GENERATE__
MQTT_MONITOR_PASSWORD=__GENERATE__
# The simulated devices (and home-test-01, used by automated tests) log in with
# passwords made from this secret. On a server with only real devices, leave
# it empty: then those accounts do not exist.
SIM_DEVICE_SECRET=__GENERATE__
# The broker address a newly registered device is told to use (in its QR code).
# For a real ESP32 on your Wi-Fi this becomes your Mac's or server's address.
MQTT_PUBLIC_HOST=localhost
# Web pages (other sites) allowed to call the API from a browser, comma separated.
CORS_ORIGINS=https://localhost:8443
# How long browsers remember "HTTPS only" (seconds). Short on your Mac; use
# 31536000 (one year) on the public server.
HSTS_MAX_AGE=3600
