{
  "name": "aquapulse-web",
  "private": true,
  "version": "0.8.0",
  "description": "AquaPulse web app (React PWA) for residents, owners and System Admins (M8)",
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "5.90.21",
    "i18next": "25.5.3",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-i18next": "15.7.4",
    "react-router": "7.9.6",
    "recharts": "3.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.18.12",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "5.0.4",
    "jsdom": "27.0.1",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vite-plugin-pwa": "1.0.3",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
