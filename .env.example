# ---------------------------------------------------------------
# AquaPulse settings. Run `make env` to create or update `.env`.
# `.env` is git-ignored, so your real secrets never reach GitHub.
# A value of __GENERATE__ becomes a random secret in your .env.
# This file grows milestone by milestone; every setting is explained.
# ---------------------------------------------------------------

# Name used for Docker containers, networks and volumes (M1).
COMPOSE_PROJECT_NAME=aquapulse

# Time zone of the demo building (M1, M6). Uses IANA names.
DEMO_TIMEZONE=Asia/Karachi

# --- Database (M1) ---
POSTGRES_DB=aquapulse
POSTGRES_USER=aquapulse
POSTGRES_PASSWORD=__GENERATE__

# --- Simulator / digital twin (M2) ---
# How many virtual homes (1 to 500). Each one is its own MQTT device.
SIM_HOMES=10
# Seconds between telemetry messages from every device (1 to 300).
SIM_INTERVAL_S=10
# Same seed = exactly the same water use every time (reproducible demos).
SIM_SEED=42
# Building code used in device IDs: home-b01-01 ... tank-b01-01.
SIM_BUILDING=b01
# Weekend days (more water is used). Gulf countries: fri,sat
SIM_WEEKEND_DAYS=sat,sun
# Overhead tank size in litres, its level when first started, and pump speed.
SIM_TANK_CAPACITY_L=5000
SIM_TANK_START_PCT=30
SIM_PUMP_LPM=60
